{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "shared/**/*.ts",
    "shared/**/*.vue",
    "src/**/*.ts",
    ".storybook/**/*.ts",
    "env.d.ts"
  ],
  "exclude": ["node_modules", "storybook-static", "shared/generated", "src/generated"]
}
