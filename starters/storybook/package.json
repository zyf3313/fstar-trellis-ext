{
  "name": "trellis-review-storybook-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "check": "node scripts/check.mjs",
    "dev": "pnpm generate && storybook dev --config-dir .storybook --port 6106",
    "build": "pnpm generate && storybook build --config-dir .storybook --output-dir storybook-static",
    "preview": "vite preview --outDir storybook-static --host 127.0.0.1 --port 6107",
    "check:build": "node scripts/build-check.mjs",
    "verify": "pnpm generate && pnpm lint && pnpm test && pnpm typecheck && pnpm check && pnpm build && pnpm check:build"
  },
  "devDependencies": {
    "@storybook/vue3-vite": "10.6.2",
    "@vitejs/plugin-vue": "6.0.10",
    "storybook": "10.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue": "3.5.44",
    "vue-tsc": "3.3.11"
  }
}
