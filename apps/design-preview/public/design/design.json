  "seed": [
    {
      "id": "REQ-001",
      "title": "统一项目初始化入口",
      "module": "规范库",
      "status": "设计中",
      "description": "识别技术栈，安装匹配规范并验证工具状态。"
    },
    {
      "id": "REQ-002",
      "title": "模块设计与交互评审",
      "module": "设计交付",
      "status": "待评审",
      "description": "按模块查看功能及页面状态，确认交互后再实施。"
    },
    {
      "id": "REQ-003",
      "title": "数据库参数化读写",
      "module": "工具接入",
      "status": "实施中",
      "description": "在明确的开发测试来源核对结构、读写和事务结果。"
    }
  ],
  "success_sample": {
    "id": "REQ-004",
    "title": "统一设计交付流程",
    "module": "设计交付",
