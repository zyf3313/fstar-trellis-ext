  "typeScale": {"caption": 12, "secondary": 13, "body": 14, "label": 15, "control": 16, "section": 17, "subheading": 18, "brand": 19, "title": 26},
  "radiusScale": {"field": 7, "control": 8, "surface": 10, "preview": 12, "dialog": 14},
  "components": [
    {
      "id": "button.primary",
      "label": "主操作",
      "states": [
        "default",
        "focus",
        "disabled",
        "loading"
      ],
      "contract": "一次提交；处理中禁用；完成后反馈"
    },
    {
      "id": "field.text",
      "label": "文本输入",
      "states": [
        "default",
        "focus",
        "invalid"
      ],
      "contract": "明确标签；错误紧邻字段；保留输入"
    },
    {
      "id": "table.requirements",
      "label": "需求列表",
      "states": [
        "normal",
        "empty",
        "error",
        "denied"
      ],
      "contract": "标题可进入详情；空和失败提供恢复入口"
    }
  ],
  "modules": [
    {
      "id": "M01",
      "name": "需求管理",
      "features": [
        {
          "id": "F01",
