          "acceptance": [
            "AC01",
            "AC02",
            "AC03",
            "AC04",
            "AC08"
          ],
          "boards": [
            {
              "id": "B01",
              "name": "需求列表",
              "state": "normal"
            },
            {
              "id": "B02",
              "name": "搜索无结果",
              "state": "empty"
            },
            {
              "id": "B03",
              "name": "加载失败",
              "state": "error"
            },
            {
              "id": "B04",
              "name": "无访问权限",
              "state": "denied"
            },
            {
              "id": "B05",
              "name": "需求详情",
              "state": "detail"
            }
          ],
          "implementation": "src/modules/requirements/RequirementsWorkspace.vue",
          "story": "src/modules/requirements/Browse.stories.ts"
        },
        {
          "id": "F02",
          "name": "新建需求",
          "prd": "docs/prd.zh-CN.md#f02",
          "tdd": "docs/tdd.zh-CN.md#f02",
          "acceptance": [
            "AC05",
            "AC06",
            "AC07"
          ],
          "boards": [
            {
              "id": "B06",
              "name": "填写需求",
              "state": "create"
            },
            {
              "id": "B07",
              "name": "字段校验失败",
              "state": "invalid"
            },
            {
              "id": "B08",
              "name": "提交成功",
              "state": "success"
            }
          ],
          "implementation": "src/modules/requirements/RequirementsWorkspace.vue",
          "story": "src/modules/requirements/Create.stories.ts"
        }
      ]
