    "primaryText": "#116A60",
    "primarySoft": "#E7F4F1",
    "info": "#3264AB",
    "infoSoft": "#EDF2FC",
    "warning": "#865C16",
    "warningSoft": "#FFF4D9",
    "neutralSoft": "#EEF1F4",
    "danger": "#B63838",
    "dangerSoft": "#FCEDED",
    "sidebar": "#162D35",
    "sidebarText": "#E5F1F1",
    "sidebarLine": "#35515B",
    "sidebarMuted": "#C4D9DD",
    "radius": 10,
    "space": 8,
    "font": "PingFang SC",
    "fontSize": 14
  },
  "layout": {
    "width": 1200,
    "height": 800,
    "sidebar": 208,
    "header": 72,
    "padding": 32,
    "contentTop": 104,
    "rowHeight": 64,
    "mobileBreakpoint": 760,
    "mobileList": "cards"
  },
  "statusStyles": {
    "待讨论": {"foreground": "muted", "background": "neutralSoft"},
    "设计中": {"foreground": "info", "background": "infoSoft"},
    "待评审": {"foreground": "warning", "background": "warningSoft"},
    "实施中": {"foreground": "primaryText", "background": "primarySoft"}
