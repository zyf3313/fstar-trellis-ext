{
  "name": "personal-design-preview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "storybook dev --host 127.0.0.1 --port 8875 --no-open --disable-telemetry",
    "build": "storybook build --output-dir dist --disable-telemetry",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "sync:design": "node scripts/sync-design.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 8875 --strictPort"
  },
  "dependencies": {
    "vue": "3.5.43",
    "marked": "17.0.5",
    "mermaid": "10.9.1",
    "dompurify": "3.3.3"
  },
  "devDependencies": {
    "@storybook/vue3-vite": "10.6.2",
    "@vitejs/plugin-vue": "6.0.10",
    "storybook": "10.6.2",
    "vite": "8.3.4",
    "typescript": "6.0.3",
    "vue-tsc": "3.2.8"
  }
}
